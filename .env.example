# Copy this file to .env and fill in only the keys you use.
# .env is gitignored. Never commit real keys.

# Claude (real tutoring). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google AI Studio (free tier: test mode / overflow). Free-tier prompts may be used for training.
GEMINI_API_KEY=

# GroqCloud (free tier: fast LLM + Whisper speech-to-text)
GROQ_API_KEY=

# Local models (no key needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Model routing
TUTOR_MODEL=claude-haiku-5-5
CURRICULUM_MODEL=claude-sonnet-5-5
ESCALATE_MODEL=claude-opus-5-5

# Which free provider test mode uses: local (Ollama), gemini or groq
TEST_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash
